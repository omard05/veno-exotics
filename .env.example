# ---------------------------------------------------------------
# VENO Exotic Car Rentals — environment configuration
# Copy to .env.local for local development.
# ---------------------------------------------------------------

# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.).
# Leave empty for local development: an embedded database is created in ./.data
DATABASE_URL=

# Admin dashboard login (/admin). Use a long, unique password.
ADMIN_PASSWORD=change-me
# Random string used to sign admin sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where booking requests and form submissions are sent.
NOTIFY_EMAIL=kareemdarwish001@gmail.com

# SMTP for outgoing email. For Gmail use smtp.gmail.com / 465 and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# If SMTP is not configured, submissions are still saved to the dashboard
# and the email is printed to the server log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VENO Exotic Car Rentals <no-reply@venoexotics.com>"

# Public site URL (used in email links)
SITE_URL=https://venoexotics.com
